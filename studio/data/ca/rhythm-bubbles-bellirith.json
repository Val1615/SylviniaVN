{"format":"sylvinia-studio-ca","version":1,"module":"rhythm-bubbles-bellirith","file":"chronique-alternative/source/src/rhythm-bubbles-bellirith.ts","hash":"d96e1be8807d85cd","label":"Bellirith · rhythm bubbles","group":"Bellirith","scenes":[{"key":"§BELLIRITH_RHYTHM_BUBBLES","title":"","section":"BELLIRITH_RHYTHM_BUBBLES","used":true}],"items":[{"id":"rhythm-bubbles-bellirith:s0hjv46d","k":"s","text":"Jeu de rythme","sc":0,"line":16,"role":"title"},{"id":"rhythm-bubbles-bellirith:s00h7f4b","k":"s","text":"Suivez sa cadence. Elle tend des leurres (notes pâles, sans cœur) et s'arrête au bord : ne touchez à rien, votre résistance nourrit son désir. Quand la piste pulse en violet, son aura va accélérer.","sc":0,"line":17,"role":"instruction"},{"id":"rhythm-bubbles-bellirith:s1pfrzq4","k":"s","text":"Résiste. J'adore ça.","sc":0,"line":19,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s1auied1","k":"s","text":"Pas encore.","sc":0,"line":19,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s0gzyz2w","k":"s","text":"Tu trembles déjà ?","sc":0,"line":19,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s0mihihs","k":"s","text":"Regarde-moi faire.","sc":0,"line":20,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s0s2wj9p","k":"s","text":"Tu tiendras ?","sc":0,"line":20,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s0jvpcas","k":"s","text":"Pas encore. Je décide.","sc":0,"line":20,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s0xhqhq2","k":"s","text":"Mieux. Continue.","sc":0,"line":21,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s00jbux2","k":"s","text":"Un point pour toi. Un seul.","sc":0,"line":21,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s0d1dg6r","k":"s","text":"Ne t'arrête pas là.","sc":0,"line":21,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s1rgxwlu","k":"s","text":"Suis-moi, si tu peux.","sc":0,"line":22,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s102xue6","k":"s","text":"Plus près.","sc":0,"line":22,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s10puro5","k":"s","text":"C'est moi qui mène.","sc":0,"line":22,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s1wtylx9","k":"s","text":"Demande mieux.","sc":0,"line":23,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s1hqodgb","k":"s","text":"Tu apprends vite.","sc":0,"line":23,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s1i3anlq","k":"s","text":"Encore. Plus fort.","sc":0,"line":23,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s1svuiru","k":"s","text":"Ne me fais pas attendre.","sc":0,"line":23,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s0tm23ue","k":"s","text":"Tu bluffes ?","sc":0,"line":26,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s03b9owx","k":"s","text":"Je compte, tu sais.","sc":0,"line":27,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s1h5getd","k":"s","text":"Un point pour moi.","sc":0,"line":28,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s1vgztei","k":"s","text":"Concentre-toi. Sur moi.","sc":0,"line":29,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s1b4je0d","k":"s","text":"Tu perds le fil ?","sc":0,"line":30,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s0apz044","k":"s","text":"Ce n'est pas un rythme, ça.","sc":0,"line":31,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s061n8db","k":"s","text":"Tu ne mords pas ? Dommage.","sc":0,"line":33,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s0b1ftho","k":"s","text":"Bien. Résiste encore.","sc":0,"line":33,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s0zkq52s","k":"s","text":"Tu me lis, maintenant ?","sc":0,"line":33,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s173apmg","k":"s","text":"Trop facile.","sc":0,"line":34,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s18bqton","k":"s","text":"Tu as cédé. Noté.","sc":0,"line":34,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s1hohy0f","k":"s","text":"Je t'ai eu·e.","sc":0,"line":34,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s0z53xrm","k":"s","text":"Tu as tenu. J'adore ça.","sc":0,"line":35,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s0225vah","k":"s","text":"Pas un geste. Parfait.","sc":0,"line":35,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s0olaq6k","k":"s","text":"Tu me plais, comme ça.","sc":0,"line":35,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s1t6nelt","k":"s","text":"Pas encore, j'ai dit.","sc":0,"line":36,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s1ob7y6q","k":"s","text":"Impatience. Un point pour moi.","sc":0,"line":36,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s11b5wnv","k":"s","text":"Tiens-toi bien.","sc":0,"line":37,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s09nqtfv","k":"s","text":"Sens-tu ça ?","sc":0,"line":37,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s1han3sj","k":"s","text":"Écoute. Puis rends-le-moi.","sc":0,"line":38,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s0oeidd0","k":"s","text":"À toi, maintenant.","sc":0,"line":38,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s1jejwrd","k":"s","text":"Elle a perdu le compte","sc":0,"line":40,"role":"title"},{"id":"rhythm-bubbles-bellirith:s0pn875c","k":"s","text":"Un point pour toi. Un seul. Le plus beau.","sc":0,"line":40,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s0qnyxoy","k":"s","text":"Égalité. Je déteste ça. Presque.","sc":0,"line":41,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith:s17gwy2w","k":"s","text":"Un point pour elle","sc":0,"line":42,"role":"titl