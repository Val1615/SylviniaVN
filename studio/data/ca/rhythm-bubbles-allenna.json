{"format":"sylvinia-studio-ca","version":1,"module":"rhythm-bubbles-allenna","file":"chronique-alternative/source/src/rhythm-bubbles-allenna.ts","hash":"62e220a5679120d7","label":"Allenna · rhythm bubbles","group":"Allenna","scenes":[{"key":"§ALLENNA_RHYTHM_BUBBLES","title":"","section":"ALLENNA_RHYTHM_BUBBLES","used":true}],"items":[{"id":"rhythm-bubbles-allenna:s0hjv46d","k":"s","text":"Jeu de rythme","sc":0,"line":16,"role":"title"},{"id":"rhythm-bubbles-allenna:s0bmieor","k":"s","text":"Suivez sa cadence, sans brusquer. Il lui arrive de s'arrêter au bord, le temps d'une hésitation : ne touchez à rien, laissez-la décider de repartir.","sc":0,"line":17,"role":"instruction"},{"id":"rhythm-bubbles-allenna:s1u1r76l","k":"s","text":"Comme ça ?","sc":0,"line":19,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1o9fnmx","k":"s","text":"Je vais y arriver.","sc":0,"line":19,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1cjzegl","k":"s","text":"Ne détournez pas les yeux.","sc":0,"line":19,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s11kvqjv","k":"s","text":"Laissez-moi faire.","sc":0,"line":20,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1ibw29o","k":"s","text":"Je sais ce que je veux.","sc":0,"line":20,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1auied1","k":"s","text":"Pas encore.","sc":0,"line":20,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s12suw0s","k":"s","text":"Là… restez là.","sc":0,"line":21,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s0s7frtl","k":"s","text":"Je ne me cache plus.","sc":0,"line":21,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1nwqodh","k":"s","text":"Encore. Doucement.","sc":0,"line":21,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s102xue6","k":"s","text":"Plus près.","sc":0,"line":22,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s0l9r014","k":"s","text":"Je vous sens.","sc":0,"line":22,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1izg8ac","k":"s","text":"Ne lâchez pas.","sc":0,"line":22,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1almk6p","k":"s","text":"Je le veux.","sc":0,"line":23,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1vpm5ln","k":"s","text":"Plus profond.","sc":0,"line":23,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1jtkzjt","k":"s","text":"Ne vous arrêtez pas.","sc":0,"line":23,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1oupo7n","k":"s","text":"Encore. Avec moi.","sc":0,"line":23,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s0zz84kh","k":"s","text":"Vous aussi, vous hésitez ?","sc":0,"line":26,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1ryf8tz","k":"s","text":"On recommence. Ensemble.","sc":0,"line":27,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s0bcrhzj","k":"s","text":"Je ne compte pas les coups.","sc":0,"line":28,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s020l83n","k":"s","text":"Regardez-moi, pas vos mains.","sc":0,"line":29,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s0qpejty","k":"s","text":"Merci d'avoir attendu.","sc":0,"line":31,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s0joso0j","k":"s","text":"Vous m'avez laissée choisir.","sc":0,"line":31,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s0jhs54c","k":"s","text":"Trop vite.","sc":0,"line":32,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s0rsj9l1","k":"s","text":"Vous avez attendu. Merci.","sc":0,"line":33,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1vcvyo8","k":"s","text":"Je suis prête, maintenant.","sc":0,"line":33,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s09mrgfq","k":"s","text":"C'est moi qui repars.","sc":0,"line":33,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s0jvpcas","k":"s","text":"Pas encore. Je décide.","sc":0,"line":34,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1ad7die","k":"s","text":"Laissez-moi respirer.","sc":0,"line":34,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s11922se","k":"s","text":"Tenez bon.","sc":0,"line":35,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1x38718","k":"s","text":"À vous.","sc":0,"line":36,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s0ahey4y","k":"s","text":"Elle ne se cache plus","sc":0,"line":38,"role":"title"},{"id":"rhythm-bubbles-allenna:s0bet3gt","k":"s","text":"Ne dites rien. Recommencez.","sc":0,"line":38,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s0q1v700","k":"s","text":"Au même pas","sc":0,"line":39,"role":"title"},{"id":"rhythm-bubbles-allenna:s1ul6jvt","k":"s","text":"Pas mal. Pour une première manche.","sc":0,"line":39,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1svt6uo","k":"s","text":"Revanche promise","sc":0,"line":40,"role":"title"},{"id":"rhythm-bubbles-allenna:s0i5g9wu","k":"s","text":"J'exige une revanche. Bientôt.","sc":0,"line":40,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1f0q3ev","k":"s","text":"Pas fini. Pas encore.","sc":0,"line":43,"sp":"Allenna","role":"text"},{"id":"rhythm-bubbles-allenna:s1hiklnr","k":"s","text":"Restez. Je suis là.","sc":0,"line":43,"sp":"Allenna","role":"text"}],"arrays":[{"id":"rhythm-bubbles-allenna:a09x2hf2","path":"ALLENNA_RHYTHM_BUBBLES.voice.main","kind":"items","len":3,"sc":0,"line":19,"top":true,"els":[[19,19],[19,19],[19,19]]},{"id":"rhythm-bubbles-allenna:a1yrhiyj","path":"ALLENNA_RHYTHM_BUBBLES.voice.bouche","kind":"items","len":3,"sc":0,"line":20,"top":true,"els":[[20,20],[20,20],[20,20]]},{"id":"rhythm-bubbles-allenna:a1wcb91d","path":"ALLENNA_RHYTHM_BUBBLES.voice.langue","kind":"items","len":3,"sc":0,"line":21,"top":true,"els":[[21,21],[21,21],[21,21]]},{"id":"rhythm-bubbles-allenna:a088pqh3","path":"ALLENNA_RHYTHM_BUBBLES.voice.frottement","kind":"items","len":3,"sc":0,