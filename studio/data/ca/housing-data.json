rte.","sc":1,"line":90,"role":"description"},{"id":"housing-data:s1t64euv","k":"s","text":"Logis de la Pierre noire","sc":1,"line":91,"role":"name"},{"id":"housing-data:s151hom6","k":"s","text":"Un appartement gothique sobre, meublé de bois sombre et tourné vers les lumières d’Akuhn’Nabad.","sc":1,"line":91,"role":"description"},{"id":"housing-data:s0olguz3","k":"s","text":"Appartement des Lanternes vertes","sc":1,"line":92,"role":"name"},{"id":"housing-data:s1u1krsu","k":"s","text":"Une demeure raffinée avec foyer, bibliothèque et balcon au-dessus de la cité obscurcie.","sc":1,"line":92,"role":"description"},{"id":"housing-data:s0yrschh","k":"s","text":"Suite des Hautes Arches","sc":1,"line":93,"role":"name"},{"id":"housing-data:s0sgwcjm","k":"s","text":"Une suite palatiale de pierre noire dont les immenses baies embrassent les tours de la capitale bannie.","sc":1,"line":93,"role":"description"},{"id":"housing-data:s0dbmise","k":"s","text":"Palais des Feux sombres","sc":1,"line":94,"role":"name"},{"id":"housing-data:s080d4tm","k":"s","text":"Un domaine souverain aux salons vastes, aux cristaux verts et aux terrasses ouvertes sur tout Akuhn’Nabad.","sc":1,"line":94,"role":"description"},{"id":"housing-data:s04uqnsb","k":"s","text":"Flocon imparfait d’Hylee","sc":3,"line":98,"role":"name"},{"id":"housing-data:s1q5ozzq","k":"s","text":"Une sculpture de glace stabilisée dont la branche asymétrique est précisément celle qu’Hylee préfère.","sc":3,"line":98,"role":"description"},{"id":"housing-data:s1wvgtkp","k":"s","text":"Billet de Remerii","sc":4,"line":99,"role":"name"},{"id":"housing-data:s0pfvin2","k":"s","text":"Le billet par lequel Remerii vous a proposé de la retrouver, simplement pour passer un moment ensemble.","sc":4,"line":99,"role":"description"},{"id":"housing-data:s00nwyv2","k":"s","text":"Ruban sans blason d’Iriana","sc":5,"line":100,"role":"name"},{"id":"housing-data:s0fabl18","k":"s","text":"Un ruban choisi au marché pour la seule raison qu’il lui plais