{"format":"sylvinia-studio-ca","version":1,"module":"rhythm-bubbles-remerii","file":"chronique-alternative/source/src/rhythm-bubbles-remerii.ts","hash":"db94333945e484d7","label":"Remerii · rhythm bubbles","group":"Remerii","scenes":[{"key":"§REMERII_RHYTHM_BUBBLES","title":"","section":"REMERII_RHYTHM_BUBBLES","used":true}],"items":[{"id":"rhythm-bubbles-remerii:s0hjv46d","k":"s","text":"Jeu de rythme","sc":0,"line":15,"role":"title"},{"id":"rhythm-bubbles-remerii:s16i63in","k":"s","text":"Remerii mesure plus qu'elle ne juge : gardez des coups réguliers, même imparfaits, elle le remarque. Dehors, elle retient sa voix. Au sommet, tenez l'appui jusqu'au bout.","sc":0,"line":16,"role":"instruction"},{"id":"rhythm-bubbles-remerii:s15u80xc","k":"s","text":"Gardez cette mesure.","sc":0,"line":18,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s1trg8k2","k":"s","text":"Régulier. C'est noté.","sc":0,"line":18,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s1njxp2y","k":"s","text":"Encore une fois, identique.","sc":0,"line":18,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s1saykxa","k":"s","text":"Laissez-moi compter.","sc":0,"line":19,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s1uzdk85","k":"s","text":"Votre souffle me renseigne.","sc":0,"line":19,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s1whfsnv","k":"s","text":"Hypothèse confirmée.","sc":0,"line":19,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s0agbk4a","k":"s","text":"Là. Ne déplacez rien.","sc":0,"line":20,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s16x3me3","k":"s","text":"Exactement ce point.","sc":0,"line":20,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s0gwiluf","k":"s","text":"Ne changez pas la courbe.","sc":0,"line":20,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s1h08t7m","k":"s","text":"Pas encore. Patience.","sc":0,"line":21,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s1qbi0sa","k":"s","text":"Je choisis l'angle.","sc":0,"line":21,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s0h17izi","k":"s","text":"Plus près. Voilà.","sc":0,"line":21,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s15u80xc.1","k":"s","text":"Gardez cette mesure.","sc":0,"line":22,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s1vpm5ln","k":"s","text":"Plus profond.","sc":0,"line":22,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s1c3lpvl","k":"s","text":"Résultat satisfaisant.","sc":0,"line":22,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s1pd59if","k":"s","text":"Restez au fond.","sc":0,"line":22,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s0x4unl8","k":"s","text":"Écart notable. Reprenez.","sc":0,"line":25,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s08c2lyf","k":"s","text":"Vous avez perdu le compte.","sc":0,"line":26,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s1x43srq","k":"s","text":"Recommençons à la mesure.","sc":0,"line":27,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s0zz4y47","k":"s","text":"Je n'ai pas demandé de variation.","sc":0,"line":28,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s07voiq1","k":"s","text":"Bien. Aucune précipitation.","sc":0,"line":30,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s1oi7f6w","k":"s","text":"Trop tôt. Je le note.","sc":0,"line":31,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s1vmn5jp","k":"s","text":"Maîtrise remarquable.","sc":0,"line":32,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s1jfzk9v","k":"s","text":"Vous anticipez. Dommage.","sc":0,"line":33,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s04qasg6","k":"s","text":"Accélérez. Un peu.","sc":0,"line":34,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-remerii:s1e1fidm","k":"s","text":"À vous de répondre.","sc":0,"line":35,"sp":"Remerii","role":"te