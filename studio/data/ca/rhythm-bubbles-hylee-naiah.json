{"format":"sylvinia-studio-ca","version":1,"module":"rhythm-bubbles-hylee-naiah","file":"chronique-alternative/source/src/rhythm-bubbles-hylee-naiah.ts","hash":"91630567a3c4e577","label":"Hylee × Naïah · rhythm bubbles","group":"Hylee × Naïah","scenes":[{"key":"§HYLEE_NAIAH_RHYTHM_BUBBLES","title":"","section":"HYLEE_NAIAH_RHYTHM_BUBBLES","used":true}],"items":[{"id":"rhythm-bubbles-hylee-naiah:s0wz2mxa","k":"s","text":"Jeu de rythme à trois","sc":0,"line":19,"role":"title"},{"id":"rhythm-bubbles-hylee-naiah:s13y47qq","k":"s","text":"Hylee donne le rythme, Naïah le casse exprès. Ses illusions (notes en contour argenté) ne comptent pas : ne les touchez pas. Quand une ombre vous retient au bord, ne bougez plus. Au sommet de Hylee, tenez la note : la partie continue.","sc":0,"line":20,"role":"instruction"},{"id":"rhythm-bubbles-hylee-naiah:s10wjqvm","k":"s","text":"Partie gagnée à trois","sc":0,"line":30,"role":"title"},{"id":"rhythm-bubbles-hylee-naiah:s1xhhgso","k":"s","text":"Tu vois ? On a gagné.","sc":0,"line":30,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee-naiah:s0hjre6o","k":"s","text":"Je réclame quand même le point.","sc":0,"line":30,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-hylee-naiah:s1ihl4oc","k":"s","text":"Score contesté","sc":0,"line":31,"role":"title"},{"id":"rhythm-bubbles-hylee-naiah:s0cnmbno","k":"s","text":"Égalité. Je conteste.","sc":0,"line":31,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-hylee-naiah:s16b5807","k":"s","text":"Revanche quand tu veux.","sc":0,"line":31,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee-naiah:s10cz1cy","k":"s","text":"Manche perdue","sc":0,"line":32,"role":"title"},{"id":"rhythm-bubbles-hylee-naiah:s1rb5hi6","k":"s","text":"Hé, ce n'est rien. On a ri, non ?","sc":0,"line":32,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee-naiah:s1fe7rnu","k":"s","text":"Moi, j'ai appris trois choses.","sc":0,"line":32,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-hylee-naiah:s0dwketo","k":"s"