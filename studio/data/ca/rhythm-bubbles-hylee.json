{"format":"sylvinia-studio-ca","version":1,"module":"rhythm-bubbles-hylee","file":"chronique-alternative/source/src/rhythm-bubbles-hylee.ts","hash":"ecd625d3ea82ed4a","label":"Hylee · rhythm bubbles","group":"Hylee","scenes":[{"key":"§HYLEE_RHYTHM_BUBBLES","title":"","section":"HYLEE_RHYTHM_BUBBLES","used":true}],"items":[{"id":"rhythm-bubbles-hylee:s0hjv46d","k":"s","text":"Jeu de rythme","sc":0,"line":15,"role":"title"},{"id":"rhythm-bubbles-hylee:s0a7gobp","k":"s","text":"Suivez le geste de Hylee : un coup à chaque battement, quand la note touche le cercle. Gardez l'appui quand elle vous retient, glissez quand elle change de geste. Elle va doucement, la dernière phase accélère jusqu'au bout.","sc":0,"line":16,"role":"instruction"},{"id":"rhythm-bubbles-hylee:s1g9v7jo","k":"s","text":"Tout doux. Je t'ai à peine effleuré.","sc":0,"line":18,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s1bvoa1c","k":"s","text":"Regarde comme tu me réponds.","sc":0,"line":18,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s076aeli","k":"s","text":"Mmh. Encore un peu, rien qu'à moi.","sc":0,"line":18,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s138v7k3","k":"s","text":"Tu as bon goût, tu sais.","sc":0,"line":19,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s0awl36q","k":"s","text":"Pas encore. J'ai d'autres projets.","sc":0,"line":19,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s18qjqmr","k":"s","text":"Oh... juste là.","sc":0,"line":20,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s0wwrxjd","k":"s","text":"Surtout, ne t'arrête pas.","sc":0,"line":20,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s0azrgib","k":"s","text":"Tu apprends vite...","sc":0,"line":20,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s18ikbgd","k":"s","text":"Tu le sens, là ?","sc":0,"line":21,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s1850db2","k":"s","text":"Mmh. Reste avec moi.","sc":0,"line":21,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s12uvak7","k":"s","text":"Oui... comme ça.","sc":0,"line":21,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s0oxsuq1","k":"s","text":"Oui... oui...","sc":0,"line":22,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s1lgz8qr","k":"s","text":"Ne t'arrête surtout pas.","sc":0,"line":22,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s0o45d3z","k":"s","text":"Encore... encore...","sc":0,"line":22,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s0sq3xdw","k":"s","text":"Avec moi. Maintenant.","sc":0,"line":22,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s0y7gn4s","k":"s","text":"Hé. Tu m'as perdue une seconde. Rattrape-moi.","sc":0,"line":25,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s1uifjj4","k":"s","text":"Je compte pour toi ? Un, deux... voilà, c'est mieux.","sc":0,"line":26,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s19dyw8f","k":"s","text":"Tu rêvasses ? Je suis juste là, tu sais.","sc":0,"line":27,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s0h8ajpr","k":"s","text":"Je t'ai vu hésiter. C'était mignon. Recommence.","sc":0,"line":28,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s1fvtmkt","k":"s","text":"Oups. On dira que c'était une figure de style.","sc":0,"line":29,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s18gy074","k":"s","text":"Tu tiens bien. J'aime ça.","sc":0,"line":31,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s1370gae","k":"s","text":"Hé, pas si vite.","sc":0,"line":32,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s15snhz2","k":"s","text":"Tu m'as attendue.","sc":0,"line":33,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s12ruavu","k":"s","text":"Trop tôt... recommence.","sc":0,"line":34,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s1tangbr","k":"s","text":"Un peu plus vite ?","sc":0,"line":35,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s0fhy3tf","k":"s","text":"À toi.","sc":0,"line":36,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s0s84aam","k":"s","text":"On n'a pas perdu une seule mesure. Je le savais.","sc":0,"line":38,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s1vjc3mq","k":"s","text":"Au même souffle","sc":0,"line":39,"role":"title"},{"id":"rhythm-bubbles-hylee:s1rc45t1","k":"s","text":"Quelques faux pas. Je recommence quand tu veux.","sc":0,"line":39,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee:s1rb5hi6","k":"s","text":"Hé, ce n'est rien. On a ri, non ?","sc":0,"line":40,"sp":"Hylee","role":"text"}],"arrays":[{"id":"rhythm-bubbles-hylee:a11e9iz8","path":"HYLEE_RHYTHM_BUBBLES.voice.main","kind":"items","len":3,"sc":0,"line":18,"top":true,"els":[[18,18],[18,18],[18,18]]},{"id":"rhythm-bubbles-hylee:a1v3jg1d","path":"HYLEE_RHYTHM_BUBBLES.voice.bouche","kind":"items","len":3,"sc":0,"line":19,"top":true,"els":[[19,19],[19,19],[19,19]]},{"id":"rhythm-bubbles-hylee:a0jv54cj","path":"HYLEE_RHYTHM_BUBBLES.voice.langue","kind":"items","len":3,"sc":0,"line":20,"top":true,"els":[[20,20],[20,20],[20,20]]},{"id":"rhythm-bubbles-hylee:a17nhocp","path":"HYLEE_RHYTHM_BUBBLES.voice.frottement","kind":"items","len":4,"sc":0,"line":21,"top":true,"els":[[21,21],[21,21],[21,21],[21,21]]},{"id":"rhythm-bubbles-hylee:a009ypwe","path":"HYLEE_RHYTHM_BUBBLES.voice.penetration","kind":"items","len":5,"sc":0,"line":22,"top":true,"els":[[22,22],[22,22],[22,22],[22,22],[22,22]]},{"id":"rhythm-bubbles-hylee:a074jcfe","path":"HYLEE_RHYTHM_BUBBLES.teases","kind":"items","len":5,"sc":0,"line":24,"top":true,"els":[[25,25],[26,26],[27,27],[28,28],[29,29]]},{"id":"rhythm-bubbles-hylee:a1rxuq2a","path":"HYLEE_RHYTHM_BUBBLES.resisted","kind":"items","len":1,"sc":0,"line":31,"top":true,"els":[[31,31]]},{"id":"rhythm-bubbles-hylee:a0jh10c6","path":"HYLEE_RHYTHM_BUBBLES.ceded","kind":"items","len":1,"sc":0,"line":32,"top":true,"els":[[32,32]]},{"id":"rhythm-bubbles-hylee:a01g6jmb","path":"HYLEE_RHYTHM_BUBBLES.bordHeld","kind":"items","len":1,"sc":0,"line":33,"top":true,"els":[[33,33]]},{"id":"rhythm-bubbles-hylee:a0wmoh55","path":"HYLEE_RHYTHM_BUBBLES.bordBroken","kind":"items","len":1,"sc":0,"line":34,"top":true,"els":[[34,34]]},{"id":"rhythm-bubbles-hylee:a1v8p15u","path":"HYLEE_RHYTHM_BUBBLES.aura","kind":"items","len":1,"sc":0,"line":35,"top":true,"els":[[35,35]]},{"id":"rhythm-bubbles-hylee:a0ldjtp1","path":"HYLEE_RHYTHM_BUBBLES.call","kind":"items","len":1,"sc":0,"line":36,"top":true,"els":[[36,36]]},{"id":"rhythm-bubbles-hylee:a1w3y3j5","path":"HYLEE_RHYTHM_BUBBLES.endings.embrasement.lines","kind":"items","len":1,"sc":0,"line":38,"top":true,"els":[[38,38]]},{"id":"rhythm-bubbles-hylee:a056550i","path":"HYLEE_RHYTHM_BUBBLES.endings.accord.lines","kind":"items","len":1,"sc":0,"line":39,"top":true,"els":[[39,39]]},{"id":"rhythm-bubbles-hylee:a1gn299t","path":"HYLEE_RHYTHM_BUBBLES.endings.tatonnement.lines","kind":"items","len":1,"sc":0,"line":40,"top":true,"els":[[40,40]]}]}