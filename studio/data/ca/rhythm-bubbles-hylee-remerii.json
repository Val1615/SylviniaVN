{"format":"sylvinia-studio-ca","version":1,"module":"rhythm-bubbles-hylee-remerii","file":"chronique-alternative/source/src/rhythm-bubbles-hylee-remerii.ts","hash":"255530fe763a1936","label":"Hylee × Remerii · rhythm bubbles","group":"Hylee × Remerii","scenes":[{"key":"§HYLEE_REMERII_RHYTHM_BUBBLES","title":"","section":"HYLEE_REMERII_RHYTHM_BUBBLES","used":true}],"items":[{"id":"rhythm-bubbles-hylee-remerii:s0wz2mxa","k":"s","text":"Jeu de rythme à trois","sc":0,"line":19,"role":"title"},{"id":"rhythm-bubbles-hylee-remerii:s14j4zp5","k":"s","text":"Deux cadences qui se connaissent par cœur. Hylee va doucement, Remerii mesure : gardez des coups réguliers. Quand l'une atteint son sommet, tenez la note jusqu'au bout : la scène continue.","sc":0,"line":20,"role":"instruction"},{"id":"rhythm-bubbles-hylee-remerii:s1cuhqft","k":"s","text":"Deux sommets, une même mesure","sc":0,"line":31,"role":"title"},{"id":"rhythm-bubbles-hylee-remerii:s11kvcr8","k":"s","text":"Hypothèse confirmée. Deux fois.","sc":0,"line":31,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-hylee-remerii:s0c20qj1","k":"s","text":"Tu vois ? Je le savais.","sc":0,"line":31,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee-remerii:s1vjc3mq","k":"s","text":"Au même souffle","sc":0,"line":32,"role":"title"},{"id":"rhythm-bubbles-hylee-remerii:s1bqi3zu","k":"s","text":"Quelques faux pas. On recommence ?","sc":0,"line":32,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee-remerii:s1c3lpvl","k":"s","text":"Résultat satisfaisant.","sc":0,"line":32,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-hylee-remerii:s0tiu3zk","k":"s","text":"Expérience à reprendre","sc":0,"line":33,"role":"title"},{"id":"rhythm-bubbles-hylee-remerii:s1rb5hi6","k":"s","text":"Hé, ce n'est rien. On a ri, non ?","sc":0,"line":33,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee-remerii:s0wama2i","k":"s","text":"Nous recommencerons.","sc":0,"line":33,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-hylee-remerii:s198wqc6","k":"s","text":"Remerii note les approximations : votre lien avec elle en garde la trace. Hylee, elle, en rit avec vous.","sc":0,"line":35,"role":"relationNote"},{"id":"rhythm-bubbles-hylee-remerii:s0nnflsk","k":"s","text":"Oh... ne vous arrêtez pas.","sc":0,"line":36,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee-remerii:s1mznoo9","k":"s","text":"Là... c'est là.","sc":0,"line":36,"sp":"Hylee","role":"text"},{"id":"rhythm-bubbles-hylee-remerii:s1ge67ux","k":"s","text":"Je... perds le compte.","sc":0,"line":36,"sp":"Remerii","role":"text"},{"id":"rhythm-bubbles-hylee-remerii:s06xq4aq","k":"s","text":"Mesure perdue. Continuez.","sc":0,"line":36,"sp":"Remerii","role":"text"}],"arrays":[{"id":"rhythm-bubbles-hylee-remerii:a0xa44jb","path":"HYLEE_REMERII_RHYTHM_BUBBLES.endings.embrasement.lines","kind":"items","len":2,"sc":0,"line":31,"top":true,"els":[[31,31],[31,31]]},{"id":"rhythm-bubbles-hylee-remerii:a0gkayck","path":"HYLEE_REMERII_RHYTHM_BUBBLES.endings.accord.lines","kind":"items","len":2,"sc":0,"line":32,"top":true,"els":[[32,32],[32,32]]},{"id":"rhythm-bubbles-hylee-remerii:a1pamq53","path":"HYLEE_REMERII_RHYTHM_BUBBLES.endings.tatonnement.lines","kind":"items","len":2,"sc":0,"line":33,"top":true,"els":[[33,33],[33,33]]},{"id":"rhythm-bubbles-hylee-remerii:a0dbtjzc","path":"HYLEE_REMERII_RHYTHM_BUBBLES.relay","kind":"items","len":4,"sc":0,"line":36,"top":true,"els":[[36,36],[36,36],[36,36],[36,36]]}]}