ext":"Une seconde main","sc":0,"line":23},{"id":"allenna-naiah-cross-quest:s1dollc4","k":"s","text":"Les portes se referment","sc":0,"line":23},{"id":"allenna-naiah-cross-quest:s0qrer6b","k":"s","text":"Une route pour revenir","sc":0,"line":23},{"id":"allenna-naiah-cross-quest:s1pcvg0a","k":"s","text":"Rejoindre Naïah aux ruines du faux portail, dans la Forêt Interdite.","sc":1,"line":26},{"id":"allenna-naiah-cross-quest:s1avuyv1","k":"s","text":"Retrouver Allenna au poste obscurci de la lisière des brumes.","sc":1,"line":27},{"id":"allenna-naiah-cross-quest:s0i9y9px","k":"s","text":"Entrer dans Akuhn’Nabad par la poterne des fondeurs, de nuit.","sc":1,"line":28},{"id":"allenna-naiah-cross-quest:s02y117x","k":"s","text":"Ouvrir l’enquête dans l’aile des registres de transit.","sc":1,"line":29},{"id":"allenna-naiah-cross-quest:s1v1obhu","k":"s","text":"Reconstituer la chaîne : traces, registres et chemins.","sc":1,"line":30},{"id":"allenna-naiah-cross-quest:s0ezompk","k":"s","text":"Examiner le dépôt secondaire de l’ancienne citerne.","sc":1,"line":31},{"id":"allenna-naiah-cross-quest:s0cgsns9","k":"s","text":"Sortir de la Cité avec ce qui peut l’être.","sc":1,"line":32},{"id":"allenna-naiah-cross-quest:s0z9us4y","k":"s","text":"Retrouver les deux sœurs au sanctuaire de Naïah.","sc":1,"line":33},{"id":"allenna-naiah-cross-quest:s0y68s05","k":"s","text":"Acte I terminé","sc":2,"line":61,"role":"label"},{"id":"allenna-naiah-cross-quest:s0tmlhhr","k":"s","text":"Leurre des ruines détruit","sc":3,"line":62,"role":"label"},{"id":"allenna-naiah-cross-quest:s1aoem18","k":"s","text":"Relation Allenna à l’étape 2","sc":4,"line":63,"role":"label"},{"id":"allenna-naiah-cross-quest:s07s3xy6","k":"s","text":"Relation Naïah à l’étape 2","sc":5,"line":64,"role":"label"},{"id":"allenna-naiah-cross-quest:s06ycxj4","k":"s","text":"Allenna et Naïah rencontrées","sc":6,"line":65,"role":"label"},{"id":"allenna-naiah-cross-quest:s0h85w7t","k":"s","text":"Amanea séjourne dans la Forêt Interdite. Allenna refuse toute rencontre tant qu’elle n’en est pas repartie.","sc":7,"line":127},{"id":"allenna-naiah-cross-quest:s10prlzz","k":"s","text":"Amanea est sur la route du fleuve. Allenna repousse la halte à son retour.","sc":7,"line":128},{"id":"allenna-naiah-cross-quest:s0z2f15a","k":"s","text":"Allenna répondra demain, au poste de la lisière.","sc":8,"line":154},{"id":"allenna-naiah-cross-quest:s1qnmqnk","k":"s","text":"La relève de la porte basse change la nuit prochaine.","sc":8,"line":154},{"id":"allenna-naiah-cross-quest:s1bo4upr","k":"s","text":"Les deux sœurs vous attendent demain soir au sanctuaire.","sc":8,"line":154},{"id":"allenna-naiah-cross-quest:t1yi8n5r","k":"t","text":"an-ext:{1}:{2}","sc":9,"line":215,"vals":["AN_DATE_SHORT[id]","d.branch"]},{"id":"allenna-naiah-cross-quest:n0cz4pbl","k":"n","text":"3","sc":10,"line":219,"role":"effet affection"},{"id":"allenna-naiah-cross-quest:n0lscq41","k":"n","text":"2","sc":10,"line":219,"role":"effet trust"},{"id":"allenna-naiah-cross-quest:n051eyyn","k":"n","text":"2","sc":10,"line":219,"role":"effet desire"},{"id":"allenna-naiah-cross-quest:n0cp53mm","k":"n","text":"2","sc":10,"line":219,"role":"effet affection"},{"id":"allenna-naiah-cross-quest:n0lid4f2","k":"n","text":"3","sc":10,"line":219,"role":"effet trust"},{"id":"allenna-naiah-cross-quest:t00b2tdg","k":"t","text":"an-orientation:{1}","sc":11,"line":247,"vals":["orientation"]},{"id":"allenna-naiah-cross-quest:t1eg73ui","k":"t","text":"an-date:{1}:{2}","sc":11,"line":250,"vals":["AN_DATE_SHORT[id]","d.branch"]},{"id":"allenna-naiah-cross-quest:t0m7e53e","k":"t","text":"an-ext-lived:{1}","sc":11,"line":251,"vals":["AN_DATE_SHORT[id]"]},{"id":"allenna-naiah-cross-quest:s1ndhzv0.1","k":"s","text":"Ce que les pierres ont gardé","sc":12,"line":287,"role":"cross-an-01"},{"id":"allenna-naiah-cross-quest:s0j4rh74.1","k":"s","text":"La sœur à la porte","sc":12,"line":287,"role":"cross-an-02"},{"id":"allenna-naiah-cross-quest:s0f22daa.1","k":"s","text":"L’invitée qui n’existe pas","sc":12,"line":287,"role":"cross-an-03"},{"id":"allenna-naiah-cross-quest:s0it4q4k.1","k":"s","text":"Les registres menteurs","sc":12,"line":288,"role":"cross-an-04"},{"id":"allenna-naiah-cross-quest:s0dtycrn.1","k":"s","text":"Une seconde main","sc":12,"line":288,"role":"cross-an-05"},{"id":"allenna-naiah-cross-quest:s1dollc4.1","k":"s","text":"Les portes se referment","sc":12,"line":288,"role":"cross-an-06"},{"id":"allenna-naiah-cross-quest:s0qrer6b.1","k":"s","text":"Une route pour revenir","sc":12,"line":289,"role":"cross-an-07"},{"id":"allenna-naiah-cross-quest:s1yo02xx","k":"s","text":"La carte corrigée","sc":12,"line":289,"role":"cross-an-m1"},{"id":"allenna-naiah-cross-quest:s1mai4s4","k":"s","text":"La pierre à aiguiser","sc":12,"line":289,"role":"cross-an-m2"},{"id":"allenna-naiah-cross-quest:s1y7hrqo","k":"s","text":"Le lac de brume","sc":12,"line":290,"role":"group-date-allenna-naiah-lake"},{"id":"allenna-naiah-cross-quest:s0ar5u74","k":"s","text":"La halte du Fleuve bleu","sc":12,"line":290,"role":"group-date-allenna-naiah-relay"},{"id":"allenna-naiah-cross-quest:s0301ie9","k":"s","text":"Un seuil pour trois","sc":12,"line":290,"role":"group-date-allenna-naiah-home"},{"id":"allenna-naiah-cross-quest:s1gljcc1","k":"s","text":"Un mot plié en bateau","sc":13,"line":295,"role":"title"},{"id":"allenna-naiah-cross-quest:s0em30ri","k":"s","text":"La barque est revenue toute seule ce matin. Elle te réclame. Moi non, évidemment. Reviens quand même. N.","sc":13,"line":295,"role":"body"},{"id":"allenna-naiah-cross-quest:s07bzlu0","k":"s","text":"Un mot humide","sc":13,"line":296,"role":"title"},{"id":"allenna-naiah-cross-quest:s0r3ouu7","k":"s","text":"Tes bottes ont oublié une chaussette sous le saule. Je la garde en otage. Rançon : une soirée. N.","sc":13,"line":296,"role":"body"},{"id":"allenna-naiah-cross-quest:s1l6rspn","k":"s","text":"Un mot qui luit","sc":13,"line":297,"role":"title"},{"id":"allenna-naiah-cross-quest:s1u5q7eo","k":"s","text":"Une luciole refuse de quitter la lanterne. Je crois qu’elle attend la suite de l’histoire. Moi aussi, un peu. N.","sc":13,"line":297,"role":"body"},{"id":"allenna-naiah-cross-quest:s1nrbdrw","k":"s","text":"Rapport de halte","sc":13,"line":298,"role":"title"},{"id":"allenna-naiah-cross-quest:s0bda1b8","k":"s","text":"La convoyeuse m’a demandé de vos nouvelles au retour. J’ai répondu que vous étiez en bonne santé. Je l’ai vérifié. A.","sc":13,"line":298,"role":"body"},{"id":"allenna-naiah-cross-quest:s0rbui8f","k":"s","text":"Note de service","sc":13,"line":299,"role":"title"},{"id":"allenna-naiah-cross-quest:s0exmu05","k":"s","text":"J’ai racheté des dés. Je m’entraîne. La prochaine fois, je gagnerai contre vous deux, sans tricher. A.","sc":13,"line":299,"role":"body"},{"id":"allenna-naiah-cross-quest:s0gbi2im","k":"s","text":"Bulletin du fleuve","sc":13,"line":300,"role":"title"},{"id":"allenna-naiah-cross-quest:s04rt8f5","k":"s","text":"Il a plu cette nuit sur la Cité. J’ai laissé un bol sur le rebord de ma fenêtre. C’est absurde. Je le laisse quand même. A.","sc":13,"line":300,"role":"body"},{"id":"allenna-naiah-cross-quest:s1liq7n0","k":"s","text":"Naïah a laissé un brin de thym séché sur la table, avec un mot : « Pour la prochaine omelette. Côté gauche seulement. »","sc":14,"line":305,"role":"cuisine"},{"id":"allenna-naiah-cross-quest:s1wotzty","k":"s","text":"Sur le rebord de la fenêtre, à l’endroit choisi par Allenna, un objet est apparu : un petit sifflet de patrouille, poli par l’usage.","sc":14,"line":306,"role":"objets"},{"id":"allenna-naiah-cross-quest:s1nomxoc","k":"s","text":"Sur la lucarne, quelqu’un a tracé à la craie deux étoiles, une rouge et une blanche, reliées par un trait.","sc":14,"line":307,"role":"toit"}],"arrays":[{"id":"allenna-naiah-cross-quest:a0tniarc","path":"AN_TITLES","kind":"paras","len":8,"sc":0,"line":21,"top":true,"els":[[22,22],[22,22],[22,22],[22,22],[23,23],[23,23],[23,23],[23,23]]},{"id":"allenna-naiah-cross-quest:a0d09clb","path":"AN_OBJECTIVES","kind":"paras","len":8,"sc":1,"line":25,"top":true,"els":[[26,26],[27,27],[28,28],[29,29],[30,30],[31,31],[32,32],[33,33]]}]}