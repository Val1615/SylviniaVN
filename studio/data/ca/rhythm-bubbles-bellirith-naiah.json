{"format":"sylvinia-studio-ca","version":1,"module":"rhythm-bubbles-bellirith-naiah","file":"chronique-alternative/source/src/rhythm-bubbles-bellirith-naiah.ts","hash":"0e37767267134a3a","label":"Bellirith × Naïah · rhythm bubbles","group":"Bellirith × Naïah","scenes":[{"key":"§BELLIRITH_NAIAH_RHYTHM_BUBBLES","title":"","section":"BELLIRITH_NAIAH_RHYTHM_BUBBLES","used":true}],"items":[{"id":"rhythm-bubbles-bellirith-naiah:s0wz2mxa","k":"s","text":"Jeu de rythme à trois","sc":0,"line":20,"role":"title"},{"id":"rhythm-bubbles-bellirith-naiah:s12zsosc","k":"s","text":"Bellirith mène et compte les points. Naïah simule : ses réactions trop parfaites (notes en contour argenté) sont des leurres, ne les touchez pas. Au bord, ne bougez plus. Quand la piste pulse en violet, l'aura de Bellirith va accélérer.","sc":0,"line":21,"role":"instruction"},{"id":"rhythm-bubbles-bellirith-naiah:s0s6rk9v","k":"s","text":"Tu ne t'es pas fait avoir.","sc":0,"line":24,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-bellirith-naiah:s0bdpxsc","k":"s","text":"Elle bluffe. Tu l'as vu.","sc":0,"line":24,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith-naiah:s0o2nxo9","k":"s","text":"Celle-là, c'était du théâtre.","sc":0,"line":25,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-bellirith-naiah:s1xtko93","k":"s","text":"Elle t'a eu·e. Moi aussi.","sc":0,"line":25,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith-naiah:s09y4ifl","k":"s","text":"Un point pour vous deux","sc":0,"line":31,"role":"title"},{"id":"rhythm-bubbles-bellirith-naiah:s1bl71nu","k":"s","text":"Un point. Pour toi, pas pour elle.","sc":0,"line":31,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith-naiah:s0n5anke","k":"s","text":"Je note quand même.","sc":0,"line":31,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-bellirith-naiah:s0ctx5qg","k":"s","text":"Partie serrée","sc":0,"line":32,"role":"title"},{"id":"rhythm-bubbles-bellirith-naiah:s1fpzw6k","k":"s","text":"Égalité. Ça l'agace.","sc":0,"line":32,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-bellirith-naiah:s02ky3qa","k":"s","text":"Presque pas.","sc":0,"line":32,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith-naiah:s1hi5cor","k":"s","text":"Le point à Naïah","sc":0,"line":33,"role":"title"},{"id":"rhythm-bubbles-bellirith-naiah:s00pj5a8","k":"s","text":"Encore un bâton pour moi.","sc":0,"line":33,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-bellirith-naiah:s1yxht68","k":"s","text":"Tu m'as fait perdre, toi.","sc":0,"line":33,"sp":"Bellirith","role":"text"},{"id":"rhythm-bubbles-bellirith-naiah:s10dhhh4","k":"s","text":"Bellirith n'aime pas la facilité : votre lien avec elle en garde la trace.","sc":0,"line":35,"role":"relationNote"}],"arrays":[{"id":"rhythm-bubbles-bellirith-naiah:a09kh0y6","path":"BELLIRITH_NAIAH_RHYTHM_BUBBLES.resisted","kind":"items","len":2,"sc":0,"line":24,"top":true,"els":[[24,24],[24,24]]},{"id":"rhythm-bubbles-bellirith-naiah:a15t47sq","path":"BELLIRITH_NAIAH_RHYTHM_BUBBLES.ceded","kind":"items","len":2,"sc":0,"line":25,"top":true,"els":[[25,25],[25,25]]},{"id":"rhythm-bubbles-bellirith-naiah:a1rxbj19","path":"BELLIRITH_NAIAH_RHYTHM_BUBBLES.endings.embrasement.lines","kind":"items","len":2,"sc":0,"line":31,"top":true,"els":[[31,31],[31,31]]},{"id":"rhythm-bubbles-bellirith-naiah:a0l1ftj2","path":"BELLIRITH_NAIAH_RHYTHM_BUBBLES.endings.accord.lines","kind":"items","len":2,"sc":0,"line":32,"top":true,"els":[[32,32],[32,32]]},{"id":"rhythm-bubbles-bellirith-naiah:a06vddfp","path":"BELLIRITH_NAIAH_RHYTHM_BUBBLES.endings.tatonnement.lines","kind":"items","len":2,"sc":0,"line":33,"top":true,"els":[[33,33],[33,33]]}]}