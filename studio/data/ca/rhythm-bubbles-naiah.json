{"format":"sylvinia-studio-ca","version":1,"module":"rhythm-bubbles-naiah","file":"chronique-alternative/source/src/rhythm-bubbles-naiah.ts","hash":"82719dbe38b5f2d3","label":"Naïah · rhythm bubbles","group":"Naïah","scenes":[{"key":"§NAIAH_RHYTHM_BUBBLES","title":"","section":"NAIAH_RHYTHM_BUBBLES","used":true}],"items":[{"id":"rhythm-bubbles-naiah:s0hjv46d","k":"s","text":"Jeu de rythme","sc":0,"line":15,"role":"title"},{"id":"rhythm-bubbles-naiah:s00x5zk7","k":"s","text":"Naïah apprend en trichant. Ses illusions (notes en contour argenté) ne comptent pas : ne les touchez pas. Quand une ombre vous retient au bord, ne bougez plus. Elle va lentement ; la difficulté, ce sont ses ruses.","sc":0,"line":16,"role":"instruction"},{"id":"rhythm-bubbles-naiah:s1580yso","k":"s","text":"Hm. Comme ça ?","sc":0,"line":18,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s0y3981u","k":"s","text":"Et si je faisais… ça ?","sc":0,"line":18,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s1b69vz2","k":"s","text":"J'ai noté.","sc":0,"line":18,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s16ykykc","k":"s","text":"Ah. C'est donc ça.","sc":0,"line":19,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s023ypuy","k":"s","text":"Celle-ci, je la garde.","sc":0,"line":19,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s1y55zbv","k":"s","text":"Tu triches, toi aussi.","sc":0,"line":20,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s09ed9z1","k":"s","text":"Je n'avais pas prévu ça.","sc":0,"line":20,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s0g5bj3s","k":"s","text":"Recommence. J'observe.","sc":0,"line":20,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s0ykbuv2","k":"s","text":"Mauvais angle. Exprès.","sc":0,"line":21,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s1uahd69","k":"s","text":"Hm. Corrigé.","sc":0,"line":21,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s1pb3rw7","k":"s","text":"Deuxième essai.","sc":0,"line":21,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s1b69vz2.1","k":"s","text":"J'ai noté.","sc":0,"line":22,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s1uahd69.1","k":"s","text":"Hm. Corrigé.","sc":0,"line":22,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s0194b2u","k":"s","text":"Raté. J'adore apprendre ça.","sc":0,"line":25,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s0qgi2jm","k":"s","text":"Tu as cru la mauvaise.","sc":0,"line":26,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s1nhi8sh","k":"s","text":"Une erreur ? Je la note.","sc":0,"line":27,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s075a2lr","k":"s","text":"Tu me laisses gagner ?","sc":0,"line":28,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s0hkdnvl","k":"s","text":"Tu l'as vue. Vexant.","sc":0,"line":30,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s04ng6wx","k":"s","text":"Pas dupe. Bien.","sc":0,"line":30,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s1fgznbl","k":"s","text":"Celle-là n'existait pas.","sc":0,"line":31,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s0mqemin","k":"s","text":"Illusion. Point pour moi.","sc":0,"line":31,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s0ektcav","k":"s","text":"Tu as tenu. Je recommence.","sc":0,"line":32,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s0nvq459","k":"s","text":"Trop tôt. Je l'ai vu venir.","sc":0,"line":33,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s1pljvbv","k":"s","text":"Plus vite ? Non.","sc":0,"line":34,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s0fhy3tf","k":"s","text":"À toi.","sc":0,"line":35,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s0e7expk","k":"s","text":"Leçon apprise","sc":0,"line":37,"role":"title"},{"id":"rhythm-bubbles-naiah:s0buan9b","k":"s","text":"Tout compris. Je déteste ça. Encore.","sc":0,"line":37,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s1reof9z","k":"s","text":"Manche nulle","sc":0,"line":38,"role":"title"},{"id":"rhythm-bubbles-naiah:s1cftsw1","k":"s","text":"Égalité. J'ai trois nouvelles ruses.","sc":0,"line":38,"sp":"Naïah","role":"text"},{"id":"rhythm-bubbles-naiah:s1kipdok","k":"s","text":"Expérience ratée","sc":0,"line":39,"role":"title"},{"id":"rhythm-bubbles-naiah:s0jck9nw","k":"s","text":"Raté. C'était passionnant.","sc":0,"line":39,"sp":"Naïah","role":"text"}],"arrays":[{"id":"rhythm-bubbles-naiah:a0dg326q","path":"NAIAH_RHYTHM_BUBBLES.voice.main","kind":"items","len":3,"sc":0,"line":18,"top":true,"els":[[18,18],[18,18],[18,18]]},{"id":"rhythm-bubbles-naiah:a1pz2vef","path":"NAIAH_RHYTHM_BUBBLES.voice.bouche","kind":"items","len":3,"sc":0,"line":19,"top":true,"els":[[19,19],[19,19],[19,19]]},{"id":"rhythm-bubbles-naiah:a16pz8gd","path":"NAIAH_RHYTHM_BUBBLES.voice.langue","kind":"items","len":3,"sc":0,"line":20,"top":true,"els":[[20,20],[20,20],[20,20]]},{"id":"rhythm-bubbles-naiah:a0fzxa1v","path":"NAIAH_RHYTHM_BUBBLES.voice.frottement","kind":"items","len":3,"sc":0,"line":21,"top":true,"els":[[21,21],[21,21],[21,21]]},{"id":"rhythm-bubbles-naiah:a0hedej0","path":"NAIAH_RHYTHM_BUBBLES.voice.penetration","kind":"items","len":2,"sc":0,"line":22,"top":true,"els":[[22,22],[22,22]]},{"id":"rhythm-bubbles-naiah:a0guuk0s","path":"NAIAH_RHYTHM_BUBBLES.teases","kind":"items","len":4,"sc":0,"line":24,"top":true,"els":[[25,25],[26,26],[27,27],[28,28]]},{"id":"rhythm-bubbles-naiah:a0zvc7eg","path":"NAIAH_RHYTHM_BUBBLES.resisted","kind":"items","len":2,"sc":0,"line":30,"top":true,"els":[[30,30],[30,30]]},{"id":"rhythm-bubbles-naiah:a14g4f0w","path":"NAIAH_RHYTHM_BUBBLES.ceded","kind":"items","len":2,"sc":0,"line":31,"top":true,"els":[[31,31],[31,31]]},{"id":"rhythm-bubbles-naiah:a0bkyqxt","path":"NAIAH_RHYTHM_BUBBLES.bordHeld","kind":"items","len":1,"sc":0,"line":32,"top":true,"els":[[32,32]]},{"id":"rhythm-bubbles-naiah:a19gqd7f","path":"NAIAH_RHYTHM_BUBBLES.bordBroken","kind":"items","len"