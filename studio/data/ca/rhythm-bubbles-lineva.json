{"format":"sylvinia-studio-ca","version":1,"module":"rhythm-bubbles-lineva","file":"chronique-alternative/source/src/rhythm-bubbles-lineva.ts","hash":"8b4f20f624b1d8f8","label":"Lineva · rhythm bubbles","group":"Lineva","scenes":[{"key":"§LINEVA_RHYTHM_BUBBLES","title":"","section":"LINEVA_RHYTHM_BUBBLES","used":true}],"items":[{"id":"rhythm-bubbles-lineva:s0hjv46d","k":"s","text":"Jeu de rythme","sc":0,"line":16,"role":"title"},{"id":"rhythm-bubbles-lineva:s0h93apt","k":"s","text":"Tenez sa cadence, elle ne ralentit jamais. Quand la piste pulse en bleu, Lineva donne un ordre : le tempo accélère quelques coups. Suivez, puis reprenez le pas.","sc":0,"line":17,"role":"instruction"},{"id":"rhythm-bubbles-lineva:s14hyk7u","k":"s","text":"Pas si vite. Si, en fait.","sc":0,"line":19,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s0ykpz86","k":"s","text":"Vous tiendrez ?","sc":0,"line":20,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s1cmijzu","k":"s","text":"Je n'ai pas dit stop.","sc":0,"line":20,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s0ei4zyz","k":"s","text":"Là. Exactement là.","sc":0,"line":21,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s1i9dilo","k":"s","text":"Ne ralentissez pas.","sc":0,"line":21,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s0rd81n4","k":"s","text":"Bien. Continuez.","sc":0,"line":21,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s1rnrcol","k":"s","text":"Plus près. C'est un ordre.","sc":0,"line":22,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s15i5eet","k":"s","text":"Plus vite.","sc":0,"line":23,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s0ok7lxp","k":"s","text":"Tenez la cadence.","sc":0,"line":23,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s1i9dilo.1","k":"s","text":"Ne ralentissez pas.","sc":0,"line":23,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s1d087lc","k":"s","text":"Reprenez. Au signal.","sc":0,"line":26,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s0a1ndrz","k":"s","text":"Vous comptiez les étoiles ?","sc":0,"line":27,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s0305iud","k":"s","text":"On reprend au début du geste.","sc":0,"line":28,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s15vcyu2","k":"s","text":"Je ne répète pas deux fois.","sc":0,"line":29,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s140ky5w","k":"s","text":"Discipline. J'aime ça.","sc":0,"line":31,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s0wmlsv8","k":"s","text":"Pas sans mon ordre.","sc":0,"line":32,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s0jbt61z","k":"s","text":"Bien tenu.","sc":0,"line":33,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s1rzfckn","k":"s","text":"Trop tôt, soldat.","sc":0,"line":34,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s15i5eet.1","k":"s","text":"Plus vite.","sc":0,"line":35,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s1i9dilo.2","k":"s","text":"Ne ralentissez pas.","sc":0,"line":35,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s1x38718","k":"s","text":"À vous.","sc":0,"line":36,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s1qlg1na","k":"s","text":"Ordre exécuté","sc":0,"line":38,"role":"title"},{"id":"rhythm-bubbles-lineva:s1sookkb","k":"s","text":"Parfait. Je n'ai rien à corriger.","sc":0,"line":38,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s011qhcy","k":"s","text":"Bon pour le service","sc":0,"line":39,"role":"title"},{"id":"rhythm-bubbles-lineva:s1bhi0c6","k":"s","text":"Correct. On peut faire mieux. Ensemble.","sc":0,"line":39,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s1i7inwm","k":"s","text":"Exercice à reprendre","sc":0,"line":40,"role":"title"},{"id":"rhythm-bubbles-lineva:s17spxgv","k":"s","text":"Repos. On reprendra l'exercice.","sc":0,"line":40,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s0oudxco","k":"s","text":"Lineva déteste l'à-peu-près : votre lien en garde la trace.","sc":0,"line":42,"role":"relationNote"},{"id":"rhythm-bubbles-lineva:s1j18vza","k":"s","text":"Un point. Pas le dernier.","sc":0,"line":44,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s1i9dilo.3","k":"s","text":"Ne ralentissez pas.","sc":0,"line":44,"sp":"Lineva","role":"text"},{"id":"rhythm-bubbles-lineva:s04maqhp","k":"s","text":"Pas de démonstration. Je veux vos mains, pas un spectacle.","sc":0,"line":45,"sp":"Lineva","role":"text"}],"arrays":[{"id":"rhythm-bubbles-lineva:a07iluwm","path":"LINEVA_RHYTHM_BUBBLES.voice.main","kind":"items","len":3,"sc":0,"line":19,"top":true,"els":[[19,19],[19,19],[19,19]]},{"id":"rhythm-bubbles-lineva:a0mc3ub7","path":"LINEVA_RHYTHM_BUBBLES.voice.bouche","kind":"items","len":3,"sc":0,"line":20,"top":true,"els":[[20,20],[20,20],[20,20]]},{"id":"rhythm-bubbles-lineva:a14e4xax","path":"LINEVA_RHYTHM_BUBBLES.voice.langue","kind":"items","len":3,"sc":0,"line":21,"top":true,"els":[[21,21],[21,21],[21,21]]},{"id":"rhythm-bubbles-lineva:a0eopjnz","path":"LINEVA_RHYTHM_BUBBLES.voice.frottement","kind":"items","len":3,"sc":0,"line":22,"top":true,"els":[[22,22],[22,22],[22,22]]},{"id":"rhythm-bubbles-lineva:a1j6zu9c","path":"LINEVA_RHYTHM_BUBBLES.voice.penetration","kind":"items","len":4,"sc":0,"line":23,"top":true,"els":[[23,23],[23,23],[23,23],[23,23]]},{"id":"rhythm-bubbles-lineva:a015ptaw","path":"LINEVA_RHYTHM_BUBBLES.teases","kind":"items","len":4,"sc":0,"line":25,"top":true,"els":[[26,26],[27,27],[28,28],[29,29]]},{"id":"rhythm-bubbles-lineva:a1q27a3g","path":"LINEVA_RHYTHM_BUBBLES.resisted","kind":"items","len":1,"sc":0,"line":31,"top":true,"els":[[31,31]]},{"id":"rhythm-bubbles-lineva:a0p9mido","path":"LINEVA_RHYTHM_BUBBLES.ceded","kind":"items","len":1,"sc":0,"line":32,"top":true,"els":[[32,32]]},{"id":"rhythm-bubbles-lineva:a1qbgsa5","path":"LINEVA_RHYTHM_BUBBLES.bordHeld","kind":"items","len":1,"sc":0,"line":33,"top":