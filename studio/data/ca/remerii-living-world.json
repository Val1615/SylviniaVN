{"format":"sylvinia-studio-ca","version":1,"module":"remerii-living-world","file":"chronique-alternative/source/src/remerii-living-world.ts","hash":"d50e02b9c33bc664","label":"Remerii · monde vivant","group":"Remerii","scenes":[{"key":"§REMERII_LETTERS","title":"","section":"REMERII_LETTERS","used":true},{"key":"letter-remerii-correction","title":"","section":"REMERII_LETTERS","used":true},{"key":"letter-remerii-print","title":"","section":"REMERII_LETTERS","used":true},{"key":"letter-remerii-recalled","title":"","section":"REMERII_LETTERS","used":true},{"key":"letter-remerii-near","title":"","section":"REMERII_LETTERS","used":true},{"key":"letter-remerii-cold","title":"","section":"REMERII_LETTERS","used":true},{"key":"§REMERII_INVITATIONS","title":"","section":"REMERII_INVITATIONS","used":true},{"key":"invite-remerii-tea","title":"La table près de la fenêtre","section":"REMERII_INVITATIONS","used":true},{"key":"invite-remerii-arcades","title":"Un détour sous les arcades","section":"REMERII_INVITATIONS","used":true},{"key":"§REMERII_WORLD_EVENTS","title":"","section":"REMERII_WORLD_EVENTS","used":true},{"key":"world-hylee-remerii-lesson","title":"La dernière coupelle","section":"REMERII_WORLD_EVENTS","used":true},{"key":"world-remerii-saidin-cup","title":"La tasse empruntée","section":"REMERII_WORLD_EVENTS","used":true},{"key":"world-remerii-book","title":"Une lectrice avant vous","section":"REMERII_WORLD_EVENTS","used":true}],"items":[{"id":"remerii-living-world:s03cs77r","k":"s","text":"À propos de votre prochain passage","sc":1,"line":13,"role":"subject"},{"id":"remerii-living-world:s1m46rdm","k":"s","text":"Un pli simple, adressé à votre nom.","sc":1,"line":13,"role":"delivery"},{"id":"remerii-living-world:n0cvmsgx","k":"n","text":"1","sc":1,"line":13,"sp":"letter-remerii-correction","role":"condition minDay"},{"id":"remerii-living-world:n1jv9v7h","k":"n","text":"1","sc":1,"line":13,"sp":"letter-remerii-correction","role":"condition minStage"},{"id":"remerii-living-world:s02gcrl1","k":"s","text":"Si vous venez à l’atelier, demandez-moi à la porte avant d’entrer dans la cour. Les horaires affichés ne tiennent pas compte des essais.","sc":1,"line":14,"role":"body"},{"id":"remerii-living-world:s1yt26tu","k":"s","text":"Vous pouvez me laisser un mot au comptoir de la bibliothèque si votre route change. Hylee y passe aussi.","sc":1,"line":14,"role":"body"},{"id":"remerii-living-world:s1uprkwp","k":"s","text":"Indiquer quand vous pensez passer.","sc":1,"line":16,"role":"label"},{"id":"remerii-living-world:s03lmpi5","k":"s","text":"« Je serai là. Si l’essai se prolonge, attendez-moi à l’intérieur. »","sc":1,"line":16,"role":"response"},{"id":"remerii-living-world:n1jmazf6","k":"n","text":"3","sc":1,"line":16,"sp":"remerii-annotate","role":"effet effects.trust"},{"id":"remerii-living-world:s0qe49w3","k":"s","text":"Prévenir que votre itinéraire reste incertain.","sc":1,"line":17,"role":"label"},{"id":"remerii-living-world:s0h9p9hx","k":"s","text":"« Dans ce cas, écrivez quand vous saurez. Je préfère une heure approximative annoncée comme telle. »","sc":1,"line":17,"role":"response"},{"id":"remerii-living-world:n0282f7j","k":"n","text":"3","sc":1,"line":17,"sp":"remerii-method","role":"effet effects.trust"},{"id":"remerii-living-world:s0l5ehpy","k":"s","text":"Une découverte regrettable","sc":2,"line":21,"role":"subject"},{"id":"remerii-living-world:s1sm5omj","k":"s","text":"Une petite feuille glissée dans votre courrier.","sc":2,"line":21,"role":"delivery"},{"id":"remerii-living-world:n07vla9s","k":"n","text":"1","sc":2,"line":21,"sp":"letter-remerii-print","role":"condition minDay"},{"id":"remerii-living-world:n0ca2d92","k":"n","text":"3","sc":2,"line":21,"sp":"letter-remerii-print","role":"condition minStage"},{"id":"remerii-living-world:s0cxto33","k":"s","text":"Le marchand de gravures a reçu une nouvelle planche. L’aigle ressemble toujours à un cheval, mais il a cette fois un nid.","sc":2,"line":22,"role":"body"},{"id":"remerii-living-world:s0nsi4mf","k":"s","text":"J’ai failli l’acheter pour vous l’envoyer. La taille du papier m’a retenue, ainsi qu’un reste de considération pour votre mur.","sc":2,"line":22,"role":"body"},{"id":"remerii-living-world:s0krs96d","k":"s","text":"Lui demander de vous le montrer à votre prochain passage.","sc":2,"line":24,"role":"label"},{"id":"remerii-living-world:s0p24s2y","k":"s","text":"« Je lui demanderai de le mettre de côté. Il risque de me croire admirative. Vous me devrez une explication. »","sc":2,"line":24,"role":"response"},{"id":"remerii-living-world:n1p2q01c","k":"n","text":"4","sc":2,"line":24,"sp":"rem-print-save","role":"effet effects.affection"},{"id":"remerii-living-world:s18uu0b6","k":"s","text":"Répondre que votre mur la remercie.","sc":2,"line":25,"role":"label"},{"id":"remerii-living-world:s0n5zvcs","k":"s","text":"« Sa gratitude est justifiée. Je tâcherai de continuer à le protéger. »","sc":2,"line":25,"role":"response"},{"id":"remerii-living-world:n18kvxfg","k":"n","text":"3","sc":2,"line":25,"sp":"rem-print-wall","role":"effet effects.affection"},{"id":"remerii-living-world:n0bm9ncl","k":"n","text":"1","sc":2,"line":25,"sp":"rem-print-wall","role":"effet effects.trust"},{"id":"remerii-living-world:s0b1mh1z","k":"s","text":"Cela m’a rappelé notre conversation","sc":3,"line":29,"role":"subject"},{"id":"remerii-living-world:s0bymibl","k":"s","text":"Le papier porte un pli rapide, sans cachet.","sc":3,"line":29,"role":"delivery"},{"id":"remerii-living-world:n061lyyd","k":"n","text":"1","sc":3,"line":29,"sp":"letter-remerii-recalled","role":"condition minDay"},{"id":"remerii-living-world:n0ge3exn","k":"n","text":"3","sc":3,"line":29,"sp":"letter-remerii-recalled","role":"condition minStage"},{"id":"remerii-living-world:s1neo0gu","k":"s","text":"Une personne a demandé aujourd’hui si l’on pouvait acheter seulement la fin d’un livre. J’ai pensé à ce que vous auriez répondu, puis j’ai constaté que je n’en savais rien.","sc":3,"line":30,"role":"body"},{"id":"remerii-living-world:s0jswy01","k":"s","text":"Je préfère donc vous poser la question. Auriez-vous payé pour éviter le début ?","sc":3,"line":30,"role":"body"},{"id":"remerii-living-world:s1w6tvwr","k":"s","text":"Préférer garder le plaisir de découvrir toute l’histoire.","sc":3,"line":32,"role":"label"},{"id":"remerii-living-world:s0t0qegn","k":"s","text":"« C’est aussi mon avis. Je ne suis simplement pas certaine de le maintenir pour tous les auteurs. »","sc":3,"line":32,"role":"response"},{"id":"remerii-living-world:n1efl6c2","k":"n","text":"3","sc":3,"line":32,"sp":"rem-recalled-no","role":"effet effects.affection"},{"id":"remerii-living-world:n0ycs13i","k":"n","text":"2","sc":3,"line":32,"sp":"rem-recalled-no","role":"effet effects.trust"},{"id":"remerii-living-world:s1lmiyh9","k":"s","text":"Avouer que cela vous aurait parfois épargné beaucoup de pages.","sc":3,"line":33,"role":"label"},{"id":"remerii-living-world:s1z07k32","k":"s","text":"« Je vous reconnais au moins le mérite de ne pas répondre pour me plaire. Donnez-moi un titre, maintenant. »","sc":3,"line":33,"role":"response"},{"id":"remerii-living-world:n078pu0c","k":"n","text":"3","sc":3,"line":33,"sp":"rem-recalled-yes","role":"effet effects.affection"},{"id":"remerii-living-world:n0zw4azw","k":"n","text":"2","sc":3,"line":33,"sp":"rem-recalled-yes","role":"effet effects.trust"},{"id":"remerii-living-world:s0s842kf","k":"s","text":"Une table libre","sc":4,"line":37,"role":"subject"},{"id":"remerii-living-world:s1ivzrnq","k":"s","text":"Votre prénom est écrit au dos d’une carte de la maison de thé.","sc":4,"line":37,"role":"delivery"},{"id":"remerii-living-world:n0acckhv","k":"n","text":"1","sc":4,"line":37,"sp":"letter-remerii-near","role":"condition minDay"},{"id":"remerii-living-world:n05s2c0r","k":"n","text":"5","sc":4,"line":37,"sp":"letter-remerii-near","role":"condition minStage"},{"id":"remerii-living-world:s04ryq0e","k":"s","text":"La table près des fenêtres était libre ce matin. J’ai eu envie de vous écrire avant même de commander.","sc":4,"line":38,"role":"body"},{"id":"remerii-living-world:s1jgys52","k":"s","text":"Si votre route vous ramène par ici, prévenez-moi. J’aimerais vous revoir. Nous choisirons une heure qui nous convienne à tous les deux.","sc":4,"line":38,"role":"body"},{"id":"remerii-living-world:s17oujtl","k":"s","text":"Répondre que vous souhaitez la revoir aussi.","sc":4,"line":40,"role":"label"},{"id":"remerii-living-world:s0xuld1a","k":"s","text":"« Alors nous trouverons une heure. J’attends vos nouvelles. »","sc":4,"line":40,"role":"response"},{"id":"remerii-living-world:n1ttiker","k":"n","text":"4","sc":4,"line":40,"sp":"rem-near-yes","role":"effet effects.affection"},{"id":"remerii-living-world:n1wgdbe6","k":"n","text":"2","sc":4,"line":40,"sp":"rem-near-yes","role":"effet effects.trust"},{"id":"remerii-living-world:s0zww123","k":"s","text":"Prévenir que vous ne pouvez pas venir prochainement.","sc":4,"line":41,"role":"label"},{"id":"remerii-living-world:s16xmz2f","k":"s","text":"« Merci de me le dire. Je garde votre lettre, et je vous écrirai encore. »","sc":4,"line":41,"role":"response"},{"id":"remerii-living-world:n1jf7w6c","k":"n","text":"3","sc":4,"line":41,"sp":"rem-near-later","role":"effet effects.trust"},{"id":"remerii-living-world:s001fsey","k":"s","text":"Pour vous voir","sc":5,"line":45,"role":"subject"},{"id":"remerii-living-world:s1tslwkb","k":"s","text":"Un billet court, fermé par un simple pli.","sc":5,"line":45,"role":"delivery"},{"id":"remerii-living-world:n13koxaj","k":"n","text":"1","sc":5,"line":45,"sp":"letter-remerii-cold","role":"condition minDay"},{"id":"remerii-living-world:n1cfgln7","k":"n","text":"5","sc":5,"line":45,"sp":"letter-remerii-cold","role":"condition minStage"},{"id":"remerii-living-world:s13wua1k","k":"s","text":"Je voudrais passer une soirée avec vous. La terrasse des lanternes, l’observatoire, ou chez vous si vous préférez recevoir.","sc":5,"line":46,"role":"body"},{"id":"remerii-living-world:s0v56icr","k":"s","text":"Choisissez ce qui vous plairait. Et si ce n’est pas le bon moment, dites-le-moi ; je ne prendrai pas un soir indisponible pour un adieu.","sc":5,"line":46,"role":"body"},{"id":"remerii-living-world:s115yqte","k":"s","text":"Lui proposer de convenir d’un rendez-vous.","sc":5,"line":48,"role":"label"},{"id":"remerii-living-world:s0dzuk2r","k":"s","text":"« Avec plaisir. Indiquez-moi le lieu ; je viendrai vous y retrouver. »","sc":5,"line":48,"role":"response"},{"id":"remerii-living-world:n1k778sd","k":"n","text":"4","sc":5,"line":48,"sp":"remerii-witness","role":"effet effects.affection"},{"id":"remerii-living-world:n1db2zqr","k":"n","text":"3","sc":5,"line":48,"sp":"remerii-witness","role":"effet effects.trust"},{"id":"remerii-living-world:s03797xv","k":"s","text":"Lui dire que vous gardez l’invitation pour plus tard.","sc":5,"line":49,"role":"label"},{"id":"remerii-living-world:s1t48iri","k":"s","text":"« Elle tient toujours. À bientôt, j’espère. »","sc":5,"line":49,"role":"response"},{"id":"remerii-living-world:n1wqiwwq","k":"n","text":"3","sc":5,"line":49,"sp":"rem-date-later","role":"effet effects.trust"},{"id":"remerii-living-world:s0t7tul9","k":"s","text":"La table près de la fenêtre","sc":7,"line":56,"role":"title"},{"id":"remerii-living-world:s1xckdv1","k":"s","text":"Remerii vous propose de la retrouver pour une boisson après son passage à la bibliothèque.","sc":7,"line":56,"role":"message"},{"id":"remerii-living-world:n1bn8wy8","k":"n","text":"1","sc":7,"line":56,"sp":"invite-remerii-tea","role":"condition minDay"},{"id":"remerii-living-world:n1ndns5i","k":"n","text":"3","sc":7,"line":56,"sp":"invite-remerii-tea","role":"condition minStage"},{"id":"remerii-living-world:s1cmdtw0","k":"s","text":"Remerii vous remercie d’avoir répondu. Elle ira prendre sa boisson et vous laisse proposer un autre moment.","sc":7,"line":57,"role":"declineText"},{"id":"remerii-living-world:s09yqg15","k":"s","text":"Remerii a posé son livre sur le rebord intérieur d’une fenêtre, près du comptoir. Elle vous fait signe avant de reprendre son paquet.","sc":7,"line":58,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s128hiv5","k":"s","text":"Je suis prête. Le livre aussi ; j’ai enfin obtenu la bonne suite.","sc":7,"line":58,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s1w4znt3","k":"s","text":"Il y en avait une mauvaise ?","sc":7,"line":58,"sp":"{player}","role":"text"},{"id":"remerii-living-world:s03f4bna","k":"s","text":"Un deuxième volume d’un autre auteur, avec une couverture très convaincante. Venez, je vous raconterai en chemin.","sc":7,"line":58,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s1enjoss","k":"s","text":"L’accompagner et lui demander ce qui a trahi le mauvais volume.","sc":7,"line":60,"role":"choix"},{"id":"remerii-living-world:s1029d7t","k":"s","text":"Le héros avait changé de nom, de métier et de continent. Je lui ai accordé deux pages par politesse.","sc":7,"line":60,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s1d1tjh4","k":"s","text":"Vous descendez les marches ensemble. Elle attend votre commande avant de choisir sa boisson.","sc":7,"line":60,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s0vejoxy","k":"s","text":"Le prochain livre sera de votre choix. Je vous laisserai davantage de deux pages.","sc":7,"line":60,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:n1fffdkr","k":"n","text":"5","sc":7,"line":60,"sp":"rem-invite-listen","role":"effet affection"},{"id":"remerii-living-world:n0gqx1j7","k":"n","text":"4","sc":7,"line":60,"sp":"rem-invite-listen","role":"effet trust"},{"id":"remerii-living-world:s0950lms","k":"s","text":"Lui raconter votre propre lecture pendant le trajet.","sc":7,"line":61,"role":"choix"},{"id":"remerii-living-world:s0m9iljf","k":"s","text":"Elle vous écoute jusqu’au comptoir, puis vous demande le titre pour le noter.","sc":7,"line":61,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s0kq9pcy","k":"s","text":"Vous me le prêteriez quand vous aurez terminé ?","sc":7,"line":61,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s04oeu0b","k":"s","text":"Vous convenez de le lui apporter à une prochaine rencontre. Elle reste avec vous jusqu’à la fin de la boisson.","sc":7,"line":61,"sp":"Narration","role":"text"},{"id":"remerii-living-world:n1tgj58l","k":"n","text":"4","sc":7,"line":61,"sp":"rem-invite-other","role":"effet affection"},{"id":"remerii-living-world:n118dlst","k":"n","text":"5","sc":7,"line":61,"sp":"rem-invite-other","role":"effet trust"},{"id":"remerii-living-world:s08pujee","k":"s","text":"Un détour sous les arcades","sc":8,"line":65,"role":"title"},{"id":"remerii-living-world:s1w021re","k":"s","text":"Remerii souhaite marcher un peu avec vous dans Mir’Aldas. Elle vous laisse choisir la durée.","sc":8,"line":65,"role":"message"},{"id":"remerii-living-world:n0e2xsqh","k":"n","text":"1","sc":8,"line":65,"sp":"invite-remerii-arcades","role":"condition minDay"},{"id":"remerii-living-world:n0by0fp5","k":"n","text":"5","sc":8,"line":65,"sp":"invite-remerii-arcades","role":"condition minStage"},{"id":"remerii-living-world:s0qyrkne","k":"s","text":"« Une autre fois, alors. Écrivez-moi quand vous pourrez. » La réponse ne ferme aucune rencontre future.","sc":8,"line":66,"role":"declineText"},{"id":"remerii-living-world:s0sezmwd","k":"s","text":"Remerii vous attend à l’abri d’une arcade. Elle vous demande si vous préférez marcher du côté du soleil ou rester sous les voûtes.","sc":8,"line":67,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s06qmyih","k":"s","text":"J’ai essayé les deux en vous attendant. Je vous laisse trancher cette affaire considérable.","sc":8,"line":67,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s1hjd2xa","k":"s","text":"Choisir le soleil et lui proposer votre bras.","sc":8,"line":69,"role":"choix"},{"id":"remerii-living-world:s149s591","k":"s","text":"Elle prend votre bras après avoir vérifié que le chemin reste sec.","sc":8,"line":69,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s0ecr9gj","k":"s","text":"Nous allons jusqu’au prochain croisement. Ensuite, nous pourrons décider que c’était trop court.","sc":8,"line":69,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s1fcaks0","k":"s","text":"Vous ralentissez tous les deux à l’approche du croisement.","sc":8,"line":69,"sp":"Narration","role":"text"},{"id":"remerii-living-world:n0b1magr","k":"n","text":"6","sc":8,"line":69,"sp":"rem-arcades-sun","role":"effet affection"},{"id":"remerii-living-world:n1lo1jo7","k":"n","text":"3","sc":8,"line":69,"sp":"rem-arcades-sun","role":"effet trust"},{"id":"remerii-living-world:s1fl1fhx","k":"s","text":"Rester sous les arcades et lui demander des nouvelles.","sc":8,"line":70,"role":"choix"},{"id":"remerii-living-world:s1qrmnzx","k":"s","text":"Elle vous parle d’une visite récente d’Hylee et du paquet qu’elles ont oublié de récupérer ensemble.","sc":8,"line":70,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s1sogxbc","k":"s","text":"Si vous voyez quelqu’un porter trois boîtes ficelées de travers, prévenez-moi. Je crains de les reconnaître.","sc":8,"line":70,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s09whuy2","k":"s","text":"Vous lui donnez vos nouvelles en traversant la place. Elle vous accompagne jusqu’à votre départ.","sc":8,"line":70,"sp":"Narration","role":"text"},{"id":"remerii-living-world:n0i2q3c2","k":"n","text":"4","sc":8,"line":70,"sp":"rem-arcades-shade","role":"effet affection"},{"id":"remerii-living-world:n0caeyj2","k":"n","text":"5","sc":8,"line":70,"sp":"rem-arcades-shade","role":"effet trust"},{"id":"remerii-living-world:s1vmfl2e","k":"s","text":"La dernière coupelle","sc":10,"line":77,"role":"title"},{"id":"remerii-living-world:n0ge6nyl","k":"n","text":"1","sc":10,"line":77,"sp":"world-hylee-remerii-lesson","role":"condition minDay"},{"id":"remerii-living-world:s0bjl2d9","k":"s","text":"Vous arrivez après un essai. Hylee tient une coupelle intacte devant Remerii, qui tente de passer pour atteindre le plateau.","sc":10,"line":78,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s0ai86gv","k":"s","text":"Tu as vu ? Jusqu’au bout.","sc":10,"line":78,"sp":"Hylee","role":"text"},{"id":"remerii-living-world:s0y76ft7","k":"s","text":"J’ai vu. Maintenant, pose-la avant que nous la cassions avec nos coudes.","sc":10,"line":78,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s1dysjhq","k":"s","text":"Hylee la pose et revient contre l’épaule de Remerii. Celle-ci lui remet une mèche derrière l’oreille avant de remarquer votre présence.","sc":10,"line":78,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s1wuhrwz","k":"s","text":"Vous tombez bien. Elle cherche un deuxième témoin.","sc":10,"line":78,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s0ysiqyc","k":"s","text":"Laisser Hylee raconter ce qu’elle a réussi.","sc":10,"line":80,"role":"choix"},{"id":"remerii-living-world:s0mivb8a","k":"s","text":"J’ai attendu avant de changer la forme. Tu vois, Remerii, je t’écoute.","sc":10,"line":80,"sp":"Hylee","role":"text"},{"id":"remerii-living-world:s18kdsli","k":"s","text":"Je vais devoir être plus aimable. Tu retiens dangereusement bien ce qui peut servir contre moi.","sc":10,"line":80,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s0pliyoa","k":"s","text":"Hylee rit et emporte le plateau. Remerii prend le reste pour la suivre.","sc":10,"line":80,"sp":"Narration","role":"text"},{"id":"remerii-living-world:n03ti3pw","k":"n","text":"2","sc":10,"line":80,"sp":"rem-world-hylee","role":"effet trust"},{"id":"remerii-living-world:n0tdnm4k","k":"n","text":"3","sc":10,"line":80,"sp":"rem-world-hylee","role":"effet affection"},{"id":"remerii-living-world:n0tdnm4k.1","k":"n","text":"3","sc":10,"line":80,"sp":"rem-world-hylee","role":"effet affection"},{"id":"remerii-living-world:s09v1tve","k":"s","text":"Les aider à dégager la table après les félicitations.","sc":10,"line":81,"role":"choix"},{"id":"remerii-living-world:s1wlttpq","k":"s","text":"Vous rassemblez les linges. Hylee vous montre où les poser, puis laisse à Remerii le choix de l’endroit où déjeuner.","sc":10,"line":81,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s11bbahp","k":"s","text":"Celui où l’on nous servira rapidement.","sc":10,"line":81,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s1eic163","k":"s","text":"Je savais que tu finirais par avoir faim.","sc":10,"line":81,"sp":"Hylee","role":"text"},{"id":"remerii-living-world:s0pmmvan","k":"s","text":"Elles quittent l’atelier ensemble et vous font signe si vous voulez venir.","sc":10,"line":81,"sp":"Narration","role":"text"},{"id":"remerii-living-world:n0ry3yh2","k":"n","text":"2","sc":10,"line":81,"sp":"rem-world-clean","role":"effet trust"},{"id":"remerii-living-world:n0s83k61","k":"n","text":"3","sc":10,"line":81,"sp":"rem-world-clean","role":"effet trust"},{"id":"remerii-living-world:n0s83k61.1","k":"n","text":"3","sc":10,"line":81,"sp":"rem-world-clean","role":"effet trust"},{"id":"remerii-living-world:s0eqolep","k":"s","text":"La tasse empruntée","sc":11,"line":85,"role":"title"},{"id":"remerii-living-world:n1vl5pcy","k":"n","text":"1","sc":11,"line":85,"sp":"world-remerii-saidin-cup","role":"condition minDay"},{"id":"remerii-living-world:s0w3xgec","k":"s","text":"Remerii tient une tasse devant Saidin. Il examine le motif avec une attention qu’elle accueille d’un regard très sec.","sc":11,"line":86,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s0sej6x6","k":"s","text":"Elle était sur votre table.","sc":11,"line":86,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s1f4f28w","k":"s","text":"C’est possible.","sc":11,"line":86,"sp":"Saidin","role":"text"},{"id":"remerii-living-world:s0emk2ej","k":"s","text":"Depuis combien de temps ?","sc":11,"line":86,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s0a7r3ts","k":"s","text":"Je l’ignore. Nous pouvons lui demander.","sc":11,"line":86,"sp":"Saidin","role":"text"},{"id":"remerii-living-world:s0r4cr56","k":"s","text":"Elle détourne la tasse au moment où il tend la main.","sc":11,"line":86,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s0y0g2n0","k":"s","text":"Vous pouvez surtout prendre la vôtre. Je vous l’ai apportée.","sc":11,"line":86,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s1lcwobh","k":"s","text":"Saidin découvre une seconde tasse dans le plateau et sourit avant de vous saluer.","sc":11,"line":86,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s0jrewfm","k":"s","text":"Leur proposer de verser le thé pendant qu’il est chaud.","sc":11,"line":88,"role":"choix"},{"id":"remerii-living-world:s04819qy","k":"s","text":"Remerii vous tend la théière. Saidin garde ses deux mains autour de la tasse qu’elle lui a choisie.","sc":11,"line":88,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s1qpme3b","k":"s","text":"Celle-ci conserve mieux la chaleur.","sc":11,"line":88,"sp":"Saidin","role":"text"},{"id":"remerii-living-world:s1h6qm3q","k":"s","text":"C’est pour cela que je l’ai prise.","sc":11,"line":88,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s0v6zs0w","k":"s","text":"Elle se sert ensuite et s’assied près de lui.","sc":11,"line":88,"sp":"Narration","role":"text"},{"id":"remerii-living-world:n0dgebwz","k":"n","text":"2","sc":11,"line":88,"sp":"rem-world-cup-pour","role":"effet affection"},{"id":"remerii-living-world:n0d6eq80","k":"n","text":"3","sc":11,"line":88,"sp":"rem-world-cup-pour","role":"effet affection"},{"id":"remerii-living-world:n0d6eq80.1","k":"n","text":"3","sc":11,"line":88,"sp":"rem-world-cup-pour","role":"effet affection"},{"id":"remerii-living-world:s0ktimza","k":"s","text":"Demander si elle compte écrire son nom sous la tasse.","sc":11,"line":89,"role":"choix"},{"id":"remerii-living-world:s0ao4tm6","k":"s","text":"C’est déjà fait.","sc":11,"line":89,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s1cl46hg","k":"s","text":"Saidin regarde sous celle qu’il tient. Remerii lève les yeux au ciel.","sc":11,"line":89,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s1wlp3j3","k":"s","text":"Vous pouvez garder celle-ci. Elle est pour vous.","sc":11,"line":89,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s0pi4uro","k":"s","text":"Alors je la reconnaîtrai.","sc":11,"line":89,"sp":"Saidin","role":"text"},{"id":"remerii-living-world:s1s2joel","k":"s","text":"Elle masque un sourire derrière sa boisson.","sc":11,"line":89,"sp":"Narration","role":"text"},{"id":"remerii-living-world:n09agh5y","k":"n","text":"2","sc":11,"line":89,"sp":"rem-world-cup-name","role":"effet affection"},{"id":"remerii-living-world:n09kg2ux","k":"n","text":"3","sc":11,"line":89,"sp":"rem-world-cup-name","role":"effet affection"},{"id":"remerii-living-world:n09kg2ux.1","k":"n","text":"3","sc":11,"line":89,"sp":"rem-world-cup-name","role":"effet affection"},{"id":"remerii-living-world:s0yc6otx","k":"s","text":"Une lectrice avant vous","sc":12,"line":93,"role":"title"},{"id":"remerii-living-world:n133kqn4","k":"n","text":"1","sc":12,"line":93,"sp":"world-remerii-book","role":"condition minDay"},{"id":"remerii-living-world:s1wqz386","k":"s","text":"Hylee rapporte un livre de la bibliothèque. Remerii le reconnaît et lui montre son propre bulletin de réservation ; celui d’Hylee est daté de la veille.","sc":12,"line":94,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s0abendn","k":"s","text":"Tu l’as réservé avant moi. Garde-le.","sc":12,"line":94,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s13zd2hv","k":"s","text":"Elle garde pourtant une main sur le coin de la couverture avant de s’en apercevoir et de le lâcher.","sc":12,"line":94,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s1b8hfrl","k":"s","text":"Je te le prêterai ensuite. Ou on le lit ensemble ?","sc":12,"line":94,"sp":"Hylee","role":"text"},{"id":"remerii-living-world:s0jydyry","k":"s","text":"Avec plaisir. Tu me gardes une place ce soir ?","sc":12,"line":94,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s02uwren","k":"s","text":"Hylee sourit et range le livre dans son sac. Remerii vous voit près de l’étagère de l’atelier.","sc":12,"line":94,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s0j96zfo","k":"s","text":"Lui demander ce qu’elle va choisir en attendant.","sc":12,"line":96,"role":"choix"},{"id":"remerii-living-world:s0fm93cu","k":"s","text":"Quelque chose de très différent. Sinon, je vais lui reprocher de ne pas être le bon livre.","sc":12,"line":96,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s1y56wdi","k":"s","text":"Elle lit plusieurs titres avant d’en tirer un mince du rayon.","sc":12,"line":96,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s0g7ryv8","k":"s","text":"Celui-ci. Vous le connaissez ?","sc":12,"line":96,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:n0xp2sbb","k":"n","text":"3","sc":12,"line":96,"sp":"rem-world-book-other","role":"effet affection"},{"id":"remerii-living-world:n0l2qjhv","k":"n","text":"2","sc":12,"line":96,"sp":"rem-world-book-other","role":"effet trust"},{"id":"remerii-living-world:s0zi1xd4","k":"s","text":"Lui faire remarquer qu’elle avait du mal à lâcher la couverture.","sc":12,"line":97,"role":"choix"},{"id":"remerii-living-world:s14nyqvy","k":"s","text":"Elle était belle. Je lui disais adieu.","sc":12,"line":97,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:s1m7vmdp","k":"s","text":"Elle rit et retire un autre ouvrage de l’étagère.","sc":12,"line":97,"sp":"Narration","role":"text"},{"id":"remerii-living-world:s1tinfdv","k":"s","text":"J’espère que vous n’êtes pas venu pour celui-là. Je commencerais à trouver la journée mesquine.","sc":12,"line":97,"sp":"Remerii","role":"text"},{"id":"remerii-living-world:n1stikhq","k":"n","text":"4","sc":12,"line":97,"sp":"rem-world-book-tease","role":"effet affection"}],"arrays":[{"id":"remerii-living-world:a14z5ngw","path":"REMERII_LETTERS","kind":"items","len":5,"sc":0,"line":11,"top":true,"els":[[12,19],[20,27],[28,35],[36,43],[44,51]]},{"id":"remerii-living-world:a1f1zmq6","path":"letter-remerii-correction.body","kind":"paras","len":2,"sc":1,"line":14,"els":[[14,14],[14,14]]},{"id":"remerii-living-world:a1lsrgda","path":"letter-remerii-correction.replies","kind":"items","len":2,"sc":1,"line":15,"els":[[16,16],[17,17]]},{"id":"remerii-living-world:a0pqzdwj","path":"letter-remerii-print.body","kind":"paras","len":2,"sc":2,"line":22,"els":[[22,22],[22,22]]},{"id":"remerii-living-world:a0ohcxtt","path":"letter-remerii-print.replies","kind":"items","len":2,"sc":2,"line":23,"els":[[24,24],[25,25]]},{"id":"remerii-living-world:a03wqdte","path":"letter-remerii-recalled.body","kind":"paras","len":2,"sc":3,"line":30,"els":[[30,30],[30,30]]},{"id":"remerii-living-world:a1ss2sk2","path":"letter-remerii-recalled.replies","kind":"items","len":2,"sc":3,"line":31,"els":[[32,32],[33,33]]},{"id":"remerii-living-world:a1ng46f4","path":"letter-remerii-near.body","kind":"paras","len":2,"sc":4,"line":38,"els":[[38,38],[38,38]]},{"id":"remerii-living-world:a1ukk3lg","path":"letter-remerii-near.replies","kind":"items","len":2,"sc":4,"line":39,"els":[[40,40],[41,41]]},{"id":"remerii-living-world:a0xetn94","path":"letter-remerii-cold.body","kind":"paras","len":2,"sc":5,"line":46,"els":[[46,46],[46,46]]},{"id":"remerii-living-world:a1yepcrg","path":"letter-remerii-cold.replies","kind":"items","len":2,"sc":5,"line":47,"els":[[48,48],[49,49]]},{"id":"remerii-living-world:a1l7e5c1","path":"REMERII_INVITATIONS","kind":"items","len":2,"sc":6,"line":54,"top":true,"els":[[55,63],[64,72]]},{"id":"remerii-living-world:a1r850t3","path":"invite-remerii-tea.intro","kind":"items","len":4,"sc":7,"line":58,"els":[[58,58],[58,58],[58,58],[58,58]]},{"id":"remerii-living-world:a1q2we01","path":"invite-remerii-tea.choices","kind":"items","l